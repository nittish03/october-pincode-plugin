# Partner Dashboard → Apps → October Pincode → Client credentials
# Prefer SHOPIFY_* names; API_KEY / SECRET are also accepted at runtime.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_app_proxy

# Neon Postgres — pooled URL for Vercel runtime (hostname includes -pooler)
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Direct Neon URL for Prisma migrate deploy only (same host without -pooler)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=

# Production app URL on Vercel (optional if VERCEL_PROJECT_PRODUCTION_URL is set)
# Example: https://pincode-plugin.vercel.app
SHOPIFY_APP_URL=

# Custom storefront domain (required for app proxy session lookup on custom domains)
# Example: octoberstore.in
SHOP_CUSTOM_DOMAIN=
